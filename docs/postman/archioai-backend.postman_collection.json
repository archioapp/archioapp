            ],
            "url": {
              "raw": "{{baseUrl}}/api/invites?room_id={{roomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invites"],
              "query": [
                {
                  "key": "room_id",
                  "value": "{{roomId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Invite",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invites/{{inviteToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invites", "{{inviteToken}}"]
            }
          }
        },
        {
          "name": "Accept Invite (Bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invites/{{inviteToken}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invites", "{{inviteToken}}", "accept"]
            }
          }
        }
